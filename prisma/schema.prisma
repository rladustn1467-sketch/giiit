// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Movie {
  id          Int      @id @default(autoincrement())
  userId      Int      @default(1) @map("user_id")
  tmdbId      Int      @map("tmdb_id")
  title       String
  posterPath  String?  @map("poster_path")
  overview    String?
  watchedDate DateTime @map("watched_date")
  rating      Float?
  review      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  conversations Conversation[]
  summaries     Summary[]
  folderMovies  FolderMovie[]

  @@map("movies")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  movieId   Int      @map("movie_id")
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model Summary {
  id          Int      @id @default(autoincrement())
  movieId     Int      @map("movie_id")
  summaryText String   @map("summary_text")
  createdAt   DateTime @default(now()) @map("created_at")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("summaries")
}

model Folder {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(1) @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  folderMovies FolderMovie[]

  @@map("folders")
}

model FolderMovie {
  folderId Int @map("folder_id")
  movieId  Int @map("movie_id")

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([folderId, movieId])
  @@map("folder_movies")
}

// "다시 추천받기"를 누를 때마다 이 유저의 기존 행을 모두 지우고 새로 채운다.
// 항상 테이블 전체가 "현재 추천 목록" 한 벌이므로 새로고침 시 그대로 재조회해서 보여줄 수 있다.
model Recommendation {
  id                 Int      @id @default(autoincrement())
  userId             Int      @default(1) @map("user_id")
  tmdbId             Int      @map("tmdb_id")
  title              String
  releaseYear        String?  @map("release_year")
  overview           String
  posterPath         String?  @map("poster_path")
  reason             String
  reasonBasis        String?  @map("reason_basis")
  genresJson         String?  @map("genres_json")
  watchProvidersJson String   @map("watch_providers_json")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("recommendations")
}

// "다시 분석하기"를 누를 때마다 이 유저의 기존 행을 모두 지우고 새로 채운다.
// 장르/평점 통계는 매번 재계산 가능하지만, AI 감상평 분석은 느리므로 결과를 저장해두고
// 새로고침 시에는 이 테이블을 그대로 읽어서 보여준다.
model TasteAnalysis {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(1) @map("user_id")
  movieCount      Int      @map("movie_count")
  genreStatsJson  String   @map("genre_stats_json")
  ratingStatsJson String   @map("rating_stats_json")
  reviewSummary   String   @map("review_summary")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("taste_analyses")
}
