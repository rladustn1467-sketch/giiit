# Copy this file to .env and fill in real values. .env is gitignored.

# Local dev: keep as a local SQLite file.
# Deployed (Turso/libSQL): "libsql://<db-name>-<org>.turso.io" + TURSO_AUTH_TOKEN below.
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# TMDB (The Movie Database) API
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Ollama (LLM for the AI chatbot feature, local dev only).
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

# Groq (used instead of Ollama whenever GROQ_API_KEY is set, e.g. in production).
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
